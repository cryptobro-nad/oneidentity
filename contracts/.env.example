# ONE — Monad Mainnet deployment configuration.
# Copy to contracts/.env and fill in. .env is gitignored.
#
# ############################################################################
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ANY.
#
# There is deliberately NO PRIVATE_KEY field. Broadcasting uses an encrypted
# Foundry keystore account (`--account one-deployer`), which prompts for a
# password at signing time. A plaintext key in .env would be readable by every
# process on the machine and one `git add -f` away from being public forever.
# See docs/MAINNET_DEPLOYMENT.md.
# ############################################################################

# --- Network ---------------------------------------------------------------
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_MAINNET_FALLBACK_RPC_URL=https://rpc3.monad.xyz
MONAD_CHAIN_ID=143

# --- Deployer --------------------------------------------------------------
# PUBLIC address only. Used for balance checks and --sender in simulations.
# Never the private key.
ONE_DEPLOYER_ADDRESS=

# --- Deployed contracts ----------------------------------------------------
# Filled in AFTER a successful broadcast. Read by VerifyONERegistry.s.sol.
ONE_REGISTRY_ADDRESS=

# --- Explorer verification -------------------------------------------------
# Only required for the Monadscan (Etherscan-compatible) path.
# NOT required for the MonadVision/Sourcify path, which needs no credential.
# Obtain from https://monadscan.com (Etherscan V2 keys cover chain 143).
EXPLORER_API_KEY=
