# ONE frontend — non-secret configuration.
# Copy to app/.env.local to override defaults. All values are PUBLIC.
#
# There are no secrets here and there must never be any. Anything prefixed
# NEXT_PUBLIC_ is inlined into the browser bundle and is world-readable.
# The app performs no writes and never handles a private key.

# Monad Mainnet. Defaults live in src/lib/chain.ts; these only override them.
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_FALLBACK_RPC_URL=https://rpc3.monad.xyz

# Deployed ONERegistry (Monad Mainnet, block 88632853, Sourcify exact_match).
# Not read by Phase 1; present for Verified ONE.
NEXT_PUBLIC_ONE_REGISTRY_ADDRESS=0xf8E62d8D16acB49eeEeCF13DE48f1f6898c2F915

# --- NFT collection discovery (optional) -----------------------------------
# BlockVision Monad Indexing API, used ONLY to discover candidate collection
# addresses and names. Balances are always re-read on-chain, never taken from
# the indexer. Without this key the app falls back to curated + user-entered
# collections; discovery is disabled but nothing else changes.
#
# Free tier: 10M compute units/month, 300 CUPS, 5 req/s. The NFT endpoint costs
# 150 CU per call, so roughly 66,000 wallet lookups/month at no cost.
# Obtain from: https://dashboard.blockvision.org
#
# SERVER-SIDE ONLY. This key is secret: it has NO NEXT_PUBLIC_ prefix so Next.js
# never inlines it into the browser bundle. Sharing API keys with third parties
# is prohibited by BlockVision's terms.
BLOCKVISION_API_KEY=