# ONE frontend — non-secret configuration.
# Copy to app/.env.local to override defaults. All values are PUBLIC.
#
# There are no secrets here and there must never be any. Anything prefixed
# NEXT_PUBLIC_ is inlined into the browser bundle and is world-readable.
# The app performs no writes and never handles a private key.

# Monad Mainnet. Defaults live in src/lib/chain.ts; these only override them.
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_FALLBACK_RPC_URL=https://rpc3.monad.xyz

# Deployed ONERegistry (Monad Mainnet, block 88632853, Sourcify exact_match).
# Not read by Phase 1; present for Verified ONE.
NEXT_PUBLIC_ONE_REGISTRY_ADDRESS=0xf8E62d8D16acB49eeEeCF13DE48f1f6898c2F915

# --- Mobile wallet connection (optional) ------------------------------------
# Reown/WalletConnect project id, from https://dashboard.reown.com
#
# PUBLIC, not a secret: it is a client identifier the browser must have to open
# a WalletConnect session, which is why it carries the NEXT_PUBLIC_ prefix.
# Still never commit a real value — this file holds a placeholder only.
#
# When absent the app degrades cleanly: injected wallets (MetaMask, Rabby,
# wallet in-app browsers) keep working, every public page keeps working, and
# builds and CI keep passing. Only the mobile/QR option is hidden.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- NFT collection discovery ----------------------------------------------
# Default is "onchain" — a self-indexed scan of each wallet's ERC-721 Transfer
# history via eth_getLogs. No credential, no paid plan, fully verifiable.
# Measured: an ordinary wallet's entire history in ~12 requests / ~3s.
#
# Override only if you have a reason:
#   onchain      (default) self-indexed log scan
#   blockvision  requires BLOCKVISION_API_KEY *and* a Pro plan (see below)
#   curated      static list; no discovery
# NFT_DISCOVERY_PROVIDER=onchain

# --- BlockVision (optional, NOT required) -----------------------------------
# BlockVision Monad Indexing API, used ONLY to discover candidate collection
# addresses and names. Balances are always re-read on-chain, never taken from
# the indexer. Without this key the app falls back to curated + user-entered
# collections; discovery is disabled but nothing else changes.
#
# MEASURED 2026-07-19: the Monad Mainnet *account* endpoints are Pro-tier only.
# A valid free-tier key returns 403 code -32609 after 30 trial requests:
#   "The Monad Mainnet Indexing API is available only to Pro-tier users."
# The advertised 10M CU free tier does NOT cover wallet enumeration.
# Only set NFT_DISCOVERY_PROVIDER=blockvision if you hold a Pro plan.
# Obtain from: https://dashboard.blockvision.org
#
# SERVER-SIDE ONLY. This key is secret: it has NO NEXT_PUBLIC_ prefix so Next.js
# never inlines it into the browser bundle. Sharing API keys with third parties
# is prohibited by BlockVision's terms.
BLOCKVISION_API_KEY=

# --- Dynamic asset discovery (Envio HyperSync, cost-free) — optional --------
# ASSET_DISCOVERY_PROVIDER selects how a wallet's assets are found:
#   curated   (default) the hand-verified token list — today's behavior
#   envio     Envio HyperSync proposes candidate contracts from Transfer logs;
#             balances/metadata are ALWAYS re-read on-chain, never trusted from
#             the indexer. Falls back to curated if Envio is unavailable.
# The default stays "curated" — dynamic discovery is opt-in and reversible by
# setting this back.
# ASSET_DISCOVERY_PROVIDER=curated
#
# ENVIO_API_TOKEN — free HyperSync token from https://envio.dev/app/api-tokens.
# Required only when ASSET_DISCOVERY_PROVIDER=envio; without it discovery falls
# back to curated. SERVER-SIDE ONLY: no NEXT_PUBLIC_ prefix, so Next.js never
# inlines it into the browser bundle. Endpoint: https://monad.hypersync.xyz (143).
ENVIO_API_TOKEN=