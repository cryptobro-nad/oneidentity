# Monad Mainnet data spike — copy to .env and fill in.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# RPC (optional). Defaults to the official public endpoints in src/rpc.ts.
# ---------------------------------------------------------------------------
# MONAD_RPC_PRIMARY=https://rpc.monad.xyz
# MONAD_RPC_FALLBACK=https://rpc2.monad.xyz

# ---------------------------------------------------------------------------
# NFT providers. Each is optional; the spike skips and reports BLOCKED for any
# provider whose credential is absent rather than pretending it passed.
# ---------------------------------------------------------------------------

# thirdweb Insight — https://thirdweb.com/dashboard (free tier available)
# Used as the `x-client-id` header against https://143.insight.thirdweb.com
THIRDWEB_CLIENT_ID=

# BlockVision — https://dashboard.blockvision.org
# Used as the `x-api-key` header against https://api.blockvision.org
BLOCKVISION_API_KEY=

# Zerion — https://developers.zerion.io (Basic auth, base64 of "<key>:")
ZERION_API_KEY=

# Rarible — https://dashboard.rarible.org (`X-API-KEY` header)
RARIBLE_API_KEY=

# Alchemy — https://dashboard.alchemy.com (NFT API v3)
ALCHEMY_API_KEY=
