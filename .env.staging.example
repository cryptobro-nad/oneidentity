# Verified ONE V2 — STAGING environment template.
#
# Variable NAMES only. Do NOT put real values here and do NOT commit a filled-in
# copy. Secrets live in your secrets manager / the Vercel dashboard, never in git.
#
# Legend for each variable:
#   [LOCAL]   set on the operator machine that runs forge + the DB script
#   [VERCEL]  set in the Vercel *Preview* environment (staging deploy)
#   [SERVER]  server-only — must never reach the browser bundle
#   [PUBLIC]  intentionally exposed to the frontend (NEXT_PUBLIC_*)
#   [SECRET]  a private key or token — never print, log, or commit
#
# =====================================================================
# A. Vercel Preview (staging app deployment)
# =====================================================================

# Neon staging Postgres connection string.            [VERCEL] [SERVER] [SECRET]
DATABASE_URL=

# Deployed staging ONERegistryV2 address. Inlined into the client bundle
# (this is the ONLY V2 var that is public).            [VERCEL] [PUBLIC]
NEXT_PUBLIC_ONE_REGISTRY_V2_ADDRESS=

# Verifier signing key. Its PUBLIC address must equal the deployed
# registry's verifier(). NEVER prefix with NEXT_PUBLIC_.  [VERCEL] [SERVER] [SECRET]
VERIFIER_PRIVATE_KEY=

# Authorises the /api/v2/link/cron indexer endpoint.   [VERCEL] [SERVER] [SECRET]
CRON_SECRET=

# Monad Mainnet RPC used by the server routes/indexer. [VERCEL] [SERVER]
MONAD_MAINNET_RPC_URL=

# Reorg-safety confirmation depth (default 8).         [VERCEL] [SERVER]
INDEXER_CONFIRMATIONS=

# =====================================================================
# B. Local operator machine — contract deployment (forge)
# =====================================================================

# Deployer key that funds gas on Monad Mainnet. NEVER goes to Vercel.
# Only its derived public address is ever printed.     [LOCAL] [SECRET]
DEPLOYER_PRIVATE_KEY=

# Immutable V1 ONERegistry address on Monad Mainnet (constructor arg).  [LOCAL]
# Known value: 0xf8E62d8D16acB49eeEeCF13DE48f1f6898c2F915
V1_REGISTRY_ADDRESS=

# Staging verifier PUBLIC address (constructor arg). Matches the public
# address of VERIFIER_PRIVATE_KEY above.               [LOCAL]
STAGING_VERIFIER_ADDRESS=

# Staging verifierAdmin address / multisig (constructor arg). A SEPARATE
# staging address, never a personal or production key.  [LOCAL]
STAGING_VERIFIER_ADMIN_ADDRESS=

# =====================================================================
# C. Local operator machine — database setup script
# =====================================================================

# Explicit confirmation that DATABASE_URL points at STAGING. The DB setup
# script refuses to run unless this equals exactly: yes  [LOCAL]
CONFIRM_STAGING_DATABASE=
